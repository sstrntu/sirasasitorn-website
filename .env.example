# Backend Environment Variables (for backend/server.js)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ENV=development

# Frontend Environment Variables
PORT=3007
REACT_APP_API_URL=http://localhost:8007
REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
PUBLIC_URL=https://your-production-domain.com

# OpenAI Configuration (REQUIRED - used by backend only)
# This key should ONLY be set in backend/.env in production
# For local development, you can set it here or in backend/.env
OPENAI_API_KEY=your_openai_api_key_here

# Optional Features
ENABLE_CHAT_ANALYTICS=true
ENABLE_RAG=true
